<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ComputerRenameTool</AssemblyName>
    <RootNamespace>ComputerRenameTool</RootNamespace>
    <AssemblyTitle>Windows 机器名修改工具</AssemblyTitle>
    <Description>Windows 机器名修改工具</Description>
    <Product>Computer Rename Tool</Product>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Company>IT Tools</Company>
    <Copyright>Copyright (c) 2026</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Required by ComputerRenameService for Win32_ComputerSystem.Rename. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Force UAC elevation at launch (requireAdministrator).
         Rename-Computer / WMI Win32_ComputerSystem.Rename require High Integrity. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </ItemGroup>

</Project>
