<UserControl x:Class="ComputerRenameTool.Views.UserControls.RenameSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ComputerRenameTool.ViewModels"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:RenameViewModel}"
             d:DesignHeight="200" d:DesignWidth="600">
    <Border Background="White"
            BorderBrush="#D8D8DC"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Style="{StaticResource SectionHeaderStyle}"
                           Text="修改机器名" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ValidationIcon}"
                           FontSize="18"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Input row with embedded status icon -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         x:Name="RenameInput"
                         Height="32"
                         Padding="8,0,32,0"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         Text="{Binding InputName, UpdateSourceTrigger=PropertyChanged, Delay=50}"
                         MaxLength="15"
                         ToolTip="{Binding ValidationMessage}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ValidationIcon}"
                           Margin="-30,0,6,0"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Foreground="{Binding ValidationIconBrush}" />
            </Grid>

            <!-- Validation message -->
            <TextBlock Margin="0,4,0,0"
                       Text="{Binding ValidationMessage}"
                       Foreground="#5A5A5A"
                       FontSize="12" />

            <!-- Suggested name -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,10,0,0"
                        Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="建议: " Foreground="#5A5A5A" />
                <TextBlock Text="{Binding SuggestedName}" FontWeight="SemiBold" />
                <Button Content="使用建议"
                        Margin="10,0,0,0"
                        Padding="10,3"
                        Command="{Binding UseSuggestedCommand}" />
            </StackPanel>

            <!-- Submit -->
            <Button x:Name="RenameButton"
                    Content="{Binding SubmitButtonText}"
                    Margin="0,16,0,0"
                    Height="36"
                    MinWidth="160"
                    HorizontalAlignment="Center"
                    Command="{Binding SubmitCommand}"
                    IsEnabled="{Binding CanSubmit}"
                    Click="RenameButton_Click"
                    Background="#0067C0"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0" />

            <!-- Submit result -->
            <TextBlock Margin="0,8,0,0"
                       Text="{Binding SubmitResult}"
                       Foreground="{Binding SubmitResultColor, Converter={StaticResource StringToBrushConverter}}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasSubmitResult, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>
    </Border>
</UserControl>
