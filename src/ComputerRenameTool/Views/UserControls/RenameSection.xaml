<UserControl x:Class="ComputerRenameTool.Views.UserControls.RenameSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ComputerRenameTool.ViewModels"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:RenameViewModel}"
             d:DesignHeight="200" d:DesignWidth="600">
    <Border Style="{StaticResource CardBorderStyle}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Style="{StaticResource SectionHeaderStyle}"
                           Text="修改机器名" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ValidationIcon}"
                           FontSize="18"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Input row with embedded status icon -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         x:Name="RenameInput"
                         Height="40"
                         Padding="12,0,40,0"
                         FontSize="14"
                         FontFamily="{StaticResource MonoFontFamily}"
                         VerticalContentAlignment="Center"
                         Text="{Binding InputName, UpdateSourceTrigger=PropertyChanged, Delay=50}"
                         MaxLength="15"
                         ToolTip="{Binding ValidationMessage}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ValidationIcon}"
                           Margin="-34,0,6,0"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Foreground="{Binding ValidationIconBrush}" />
            </Grid>

            <!-- Validation message -->
            <TextBlock Margin="0,6,0,0"
                       Text="{Binding ValidationMessage}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12" />

            <!-- Suggested name -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,10,0,0"
                        Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="建议: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                <TextBlock Text="{Binding SuggestedName}"
                           FontFamily="{StaticResource MonoFontFamily}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentCyanBrush}" />
                <Button Content="使用建议"
                        Margin="10,0,0,0"
                        Padding="10,4"
                        Command="{Binding UseSuggestedCommand}"
                        Style="{StaticResource SecondaryButton}" />
            </StackPanel>

            <!-- Submit -->
            <Button x:Name="RenameButton"
                    Content="{Binding SubmitButtonText}"
                    Margin="0,16,0,0"
                    Height="40"
                    MinWidth="180"
                    HorizontalAlignment="Center"
                    Command="{Binding SubmitCommand}"
                    IsEnabled="{Binding CanSubmit}"
                    Click="RenameButton_Click"
                    Style="{StaticResource LiftButton}" />

            <!-- Submit result -->
            <TextBlock Margin="0,10,0,0"
                       Text="{Binding SubmitResult}"
                       Foreground="{Binding SubmitResultColor, Converter={StaticResource StringToBrushConverter}}"
                       FontSize="13"
                       FontFamily="{StaticResource MonoFontFamily}"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasSubmitResult, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>
    </Border>
</UserControl>
