<UserControl x:Class="ComputerRenameTool.Views.UserControls.HardwareInfoSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ComputerRenameTool.ViewModels"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:HardwareInfoViewModel}"
             d:DesignHeight="160" d:DesignWidth="600">
    <Border Background="White"
            BorderBrush="#D8D8DC"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="电脑配置" />

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource LabelStyle}" Text="CPU:" />
                <TextBlock Grid.Column="1"
                           Style="{StaticResource ValueStyle}"
                           Text="{Binding Cpu}"
                           ToolTip="{Binding Cpu}" />
            </Grid>

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource LabelStyle}" Text="内存:" />
                <TextBlock Grid.Column="1" Style="{StaticResource ValueStyle}" Text="{Binding Memory}" />
            </Grid>

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource LabelStyle}" Text="显卡:" />
                <TextBlock Grid.Column="1"
                           Style="{StaticResource ValueStyle}"
                           Text="{Binding Gpu}"
                           ToolTip="{Binding Gpu}" />
            </Grid>

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource LabelStyle}" Text="硬盘:" />
                <TextBlock Grid.Column="1"
                           Style="{StaticResource ValueStyle}"
                           Text="{Binding Disk}"
                           ToolTip="{Binding Disk}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
