<Window x:Class="ComputerRenameTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ComputerRenameTool.ViewModels"
        xmlns:views="clr-namespace:ComputerRenameTool.Views.UserControls"
        Title="Windows 机器名修改工具"
        Height="500" Width="600"
        MinHeight="440" MinWidth="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        Loaded="MainWindow_OnLoaded">
    <Window.Resources>
        <vm:MainViewModel x:Key="MainVM" />
    </Window.Resources>

    <Window.DataContext>
        <Binding Source="{StaticResource MainVM}" />
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Accent gradient bar (top) -->
        <Border Grid.Row="0" Height="2" CornerRadius="1" Margin="0,0,0,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00D9FF" Offset="0" />
                    <GradientStop Color="#7C3AED" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Tab control (rename | hardware) — FIX-REQUEST-8 -->
        <TabControl Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    SelectedIndex="0">
            <TabItem Header="重命名">
                <views:RenameSection Margin="0,12,0,0" DataContext="{Binding Rename}" />
            </TabItem>
            <TabItem Header="电脑配置">
                <ScrollViewer Margin="0,12,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <views:HardwareReportSection DataContext="{Binding Hardware}" />
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer hint + status bar -->
        <Border Grid.Row="2"
                Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8"
                Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="修改完成后需要重启电脑才能生效。"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource AccentCyanBrush}"
                           FontWeight="SemiBold" />
            </Grid>
        </Border>
    </Grid>
</Window>