<Window x:Class="ComputerRenameTool.Views.RebootPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="即将重启"
        Height="220" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgPrimaryBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="14">
    <Border Style="{StaticResource CardBorderStyle}" Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       x:Name="HeaderText"
                       Text="系统将在以下秒数后重启:"
                       FontSize="14"
                       Foreground="{StaticResource TextPrimaryBrush}" />

            <TextBlock Grid.Row="1"
                       x:Name="CountdownText"
                       Text="60"
                       FontSize="48"
                       FontFamily="{StaticResource MonoFontFamily}"
                       FontWeight="Bold"
                       Foreground="{StaticResource AccentCyanBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,16,0,0" />

            <TextBlock Grid.Row="2" />

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="取消重启"
                        MinWidth="110"
                        Height="36"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"
                        Style="{StaticResource SecondaryButton}" />
                <Button x:Name="RebootNowButton"
                        Content="立即重启"
                        MinWidth="110"
                        Height="36"
                        Click="RebootNowButton_Click"
                        Style="{StaticResource LiftButton}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
