<Window x:Class="ComputerRenameTool.Views.RebootPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="即将重启"
        Height="200" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="HeaderText"
                   Text="系统将在以下秒数后重启:"
                   FontSize="14"
                   Foreground="#202020" />

        <TextBlock Grid.Row="1"
                   x:Name="CountdownText"
                   Text="60"
                   FontSize="48"
                   FontWeight="Bold"
                   Foreground="#0067C0"
                   HorizontalAlignment="Center"
                   Margin="0,16,0,0" />

        <TextBlock Grid.Row="2" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="CancelButton"
                    Content="取消重启"
                    MinWidth="100"
                    Height="32"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click" />
            <Button x:Name="RebootNowButton"
                    Content="立即重启"
                    MinWidth="100"
                    Height="32"
                    Click="RebootNowButton_Click"
                    Background="#0067C0"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</Window>
