<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:ComputerRenameTool.Helpers">

    <!-- Status icon brushes -->
    <SolidColorBrush x:Key="StatusValidBrush" Color="#1B8E3B" />
    <SolidColorBrush x:Key="StatusInvalidBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="StatusNeutralBrush" Color="#9A9A9A" />

    <!-- Group box header style -->
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#202020" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Label/value row style -->
    <Style x:Key="LabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#5A5A5A" />
        <Setter Property="Width" Value="80" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#202020" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <helpers:StringToBrushConverter x:Key="StringToBrushConverter" />

</ResourceDictionary>
